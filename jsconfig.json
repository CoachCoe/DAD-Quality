{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "target": "ES2023",
    "types": ["node"],
    "useUnknownInCatchVariables": false
  },
  "include": ["src/**/*.js", "scripts/**/*.js", "web/**/*.js"]
}
