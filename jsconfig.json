{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "target": "ES2023",
    "types": ["node"],
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/core.js",
    "src/experiment-contract.js",
    "src/experiments.js",
    "src/model-provider.js",
    "src/performance-config.js",
    "src/scenarios.js",
    "src/source-reader.js",
    "src/targets/dad/compose.js",
    "src/targets/dad/config.js",
    "src/process.js",
    "src/targets/**/*.js",
    "src/browser.js",
    "src/agent.js",
    "src/discovery.js",
    "src/discovery-browser.js",
    "src/discovery-fixture.js",
    "src/discovery-benchmark.js",
    "src/runner.js",
    "src/discovery-runner.js",
    "src/discovery-report.js",
    "src/application-memory.js",
    "src/history.js",
    "src/release.js",
    "src/policy.js",
    "src/performance.js"
  ]
}
