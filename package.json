{
  "name": "atm-quality",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local release validation and bounded AI exploration for web applications",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/serve.js",
    "atm": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/*.browser.js",
    "test:live": "node scripts/verify-dashboard.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "playwright": "1.64.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0"
  }
}
