{
  "name": "atm-quality",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local release validation and bounded AI exploration for web applications",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.atm/agent.env src/serve.js",
    "atm": "node --env-file-if-exists=.atm/agent.env src/cli.js",
    "explore": "node --env-file-if-exists=.atm/agent.env src/cli.js explore",
    "github-ci": "node scripts/github-ci.js",
    "aws:sync": "node scripts/aws-sync-run.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/*.browser.js",
    "test:fixture": "node --test test/fixture.postgres.js",
    "test:live": "node scripts/verify-dashboard.js",
    "check": "node scripts/check.js",
    "typecheck": "tsc --project jsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "benchmark:discovery": "node --env-file-if-exists=.atm/agent.env scripts/benchmark-discovery.js",
    "model:check": "node --env-file-if-exists=.atm/agent.env scripts/check-model.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1159.0",
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/lib-dynamodb": "3.1159.0",
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
